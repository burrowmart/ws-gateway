# Server
PORT=3000
NODE_ENV=development

# Auth
# AUTH_DISABLED=true skips identity extraction (tests/local dev).
# Signature verification lives in the Envoy PEP, not in the app.
AUTH_DISABLED=false

# WS handshake ticket — HMAC secret, min 16 chars. Rotate via Secrets Manager
# in prod; any local value works for dev.
WS_TICKET_SECRET=dev-only-secret-change-me-please
WS_TICKET_TTL_SECONDS=30

# Heartbeat — ping every 30s, terminate a connection with no pong for 70s
WS_HEARTBEAT_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=70000

# Redis — pub/sub fan-out backbone + single-use ticket store
# docker compose -f ../platform-infra/docker-compose.yml up -d redis
REDIS_URL=redis://localhost:6379

# Upstream REST services called on channel-join (membership check) and resume
# (missed-message replay) — never for domain writes.
CHAT_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Observability — OpenTelemetry
# Leave blank to use ConsoleSpanExporter (prints to stdout) for local dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ws-gateway
